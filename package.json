{
  "name": "gridfinity-studio",
  "author": "Mike Hansen <mike@unstablestudios.com>",
  "version": "1.14.0",
  "description": "Gridfinity Studio is an Electron-based application for designing and managing Gridfinity modular storage systems.",
  "main": "./out/main/index.js",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "electron-vite build && playwright test",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run test:e2e",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "pnpm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "electron-vite build && electron-builder --dir",
    "build:win": "electron-vite build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "commitlint": "commitlint --edit",
    "commit": "cz",
    "prepare": "husky"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unstable-studios/gridfinity-studio.git"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.22.3",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-menubar": "^1.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tailwindcss/vite": "^4.3.5",
    "@unstable-studios/ui": "^1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "earcut": "^3.2.4",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.11",
    "jszip": "^3.10.2",
    "konva": "^10.10.0",
    "lucide-react": "^1.77.0",
    "manifold-3d": "^3.5.5",
    "mitt": "^3.0.1",
    "motion": "^12.43.0",
    "react-colorful": "^5.8.1",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "three": "^0.184.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/cz-commitlint": "^21.2.4",
    "@commitlint/prompt": "^21.2.4",
    "@commitlint/prompt-cli": "^21.2.4",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@react-three/eslint-plugin": "^0.1.2",
    "@types/earcut": "^3.0.0",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "commitizen": "^4.3.2",
    "electron": "^42.11.18",
    "electron-builder": "^26.18.0",
    "electron-builder-squirrel-windows": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.12",
    "vitest-canvas-mock": "^1.2.0"
  },
  "packageManager": "pnpm@11.29.0"
}
